{
  "compilerOptions": {
    "strict": false,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "lib": ["ES2020", "DOM"],
    "baseUrl": "..",
    "paths": {
      "cc": ["_shims/cc.ts"],
      "cc/env": ["_shims/cc-env.ts"]
    }
  },
  "include": ["../assets/scripts/**/*.ts", "../_shims/cc.ts", "../_shims/cc-env.ts"]
}
